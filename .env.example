# MongoDB connection string (local dev via Homebrew mongodb-community@7.0)
MONGODB_URI=mongodb://127.0.0.1:27017/octavise

# Payload Secret Key
# Generate a secure random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Server Port
PORT=3001
