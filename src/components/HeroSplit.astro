          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 140 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="12" width="20" height="16" rx="3" fill="currentColor" opacity="0.2"/>
