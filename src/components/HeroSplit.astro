---
// Hero section with split layout: copy panel + world-class dashboard preview
---

<section class="hero-section">
  <div class="hero-split">
    <div class="hero-copy-panel">
      <a class="hero-proof" href="#testimonial">Watch how our customers use Octavise <span>→</span></a>
      <h1>Get more patients from the ads you're already paying for.</h1>
      <p class="hero-text">
        Connect Meta and Google Ads with your practice management data, then see
        which campaigns become bookings, new patients, and revenue.
      </p>
      <div class="hero-actions" id="start">
        <a class="button dark hero-primary" href="#start">Claim founding offer</a>
      </div>
    </div>

    <div class="hero-app" aria-label="Product preview">
      <img src="/dashboard.png" alt="Octavise dashboard showing practice analytics" class="dashboard-preview" />
    </div>
  </div>

  <div class="hero-logo-strip">
    <div class="container">
      <div class="logo-carousel">
        <div class="logo-track">
        <!-- First set of logos -->
        <div class="logo-item">
          <svg viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="20" height="20" rx="4" fill="currentColor" opacity="0.2"/>
            <text x="40" y="25" fill="currentColor" font-size="16" font-weight="600">Nookal</text>
          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="10" fill="currentColor" opacity="0.2"/>
            <text x="40" y="25" fill="currentColor" font-size="16" font-weight="600">Cliniko</text>
          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 10L25 20L15 30L10 25L17 20L10 15L15 10Z" fill="currentColor" opacity="0.2"/>
            <text x="40" y="25" fill="currentColor" font-size="16" font-weight="600">Meta</text>
          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 120 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="15" width="20" height="10" rx="2" fill="currentColor" opacity="0.2"/>
            <text x="40" y="25" fill="currentColor" font-size="16" font-weight="600">Google</text>
          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 140 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="15" cy="20" r="6" fill="currentColor" opacity="0.2"/>
