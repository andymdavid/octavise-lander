            <text x="40" y="25" fill="currentColor" font-size="16" font-weight="600">Practice A</text>
          </svg>
        </div>
        <div class="logo-item">
          <svg viewBox="0 0 140 40" fill="none" xmlns="http://www.w3.org/2000/svg">
