---
// Customer testimonial video section
---

<section class="security-section testimonial-section" id="testimonial">
  <div class="container security-grid">
    <div>
      <div class="feature-kicker testimonial-kicker">Customer stories</div>
      <h2>See how healthcare practices use Octavise</h2>
      <p>
        Real customers share how Octavise helps them understand which ads
        drive new patients and revenue for their practice.
      </p>
    </div>
    <div class="testimonial-video">
      <iframe
        src="https://www.youtube.com/embed/6on2goMObIY?cc_load_policy=0"
        title="Customer testimonial video"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
