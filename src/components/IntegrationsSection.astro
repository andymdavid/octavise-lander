---
// Integrations section
---

<section class="section container integrations">
  <div class="integrations-intro">
    <div class="feature-kicker">Integrations</div>
    <h2>Connect the systems your practice already uses.</h2>
    <p>
      Octavise sits between practice management and advertising platforms,
      removing the manual reconciliation work that makes performance reporting
      slow and unreliable.
    </p>
  </div>
  <div class="integration-flow">
    <div class="flow-column flow-left">
      <div class="flow-card source-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="integration-logo nookal-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="8" height="8" rx="2" fill="currentColor" opacity="0.3"/>
              <rect x="13" y="3" width="8" height="8" rx="2" fill="currentColor" opacity="0.6"/>
              <rect x="3" y="13" width="8" height="8" rx="2" fill="currentColor" opacity="0.6"/>
              <rect x="13" y="13" width="8" height="8" rx="2" fill="currentColor"/>
            </svg>
          </div>
          <div class="integration-info">
            <span class="integration-name">Nookal</span>
            <span class="integration-type">Practice Management</span>
          </div>
        </div>
      </div>
      <div class="flow-card source-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="integration-logo cliniko-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z" fill="currentColor" opacity="0.3"/>
              <circle cx="12" cy="12" r="3" fill="currentColor"/>
            </svg>
          </div>
          <div class="integration-info">
            <span class="integration-name">Cliniko</span>
            <span class="integration-type">Practice Management</span>
          </div>
        </div>
      </div>
    </div>

    <div class="flow-center-container">
      <div class="flow-connector-line left-connector">
        <div class="connector-dot"></div>
        <div class="connector-pulse"></div>
      </div>

      <div class="octavise-hub">
        <div class="hub-glow"></div>
        <div class="hub-content">
          <div class="octavise-logo">
            <svg viewBox="0 0 100 100">
              <g fill="currentColor">
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(45 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(90 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(135 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(180 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(225 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(270 50 50)" />
                <path d="M46 53C47 40 46 22 61 11c4-3 9 0 8 5-3 14-11 24-15 34-2.5 6-6.5 6-8 3Z" transform="rotate(315 50 50)" />
              </g>
              <circle cx="50" cy="50" r="8" fill="#2563eb" />
            </svg>
          </div>
          <span class="hub-label">Octavise</span>
        </div>
      </div>

      <div class="flow-connector-line right-connector">
        <div class="connector-pulse"></div>
        <div class="connector-dot"></div>
      </div>
    </div>

    <div class="flow-column flow-right">
      <div class="flow-card destination-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="integration-logo meta-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.5 4c-1.5 0-2.5 1-2.5 2.5 0 1.2.8 2.2 2 2.4v6.2c-1.2.2-2 1.2-2 2.4 0 1.5 1 2.5 2.5 2.5s2.5-1 2.5-2.5c0-1.2-.8-2.2-2-2.4V8.9c1.2-.2 2-1.2 2-2.4C12 5 11 4 9.5 4zm5 0c-1.5 0-2.5 1-2.5 2.5 0 1.2.8 2.2 2 2.4v6.2c-1.2.2-2 1.2-2 2.4 0 1.5 1 2.5 2.5 2.5s2.5-1 2.5-2.5c0-1.2-.8-2.2-2-2.4V8.9c1.2-.2 2-1.2 2-2.4C17 5 16 4 14.5 4z" fill="currentColor"/>
            </svg>
          </div>
          <div class="integration-info">
            <span class="integration-name">Meta Ads</span>
            <span class="integration-type">Advertising Platform</span>
          </div>
        </div>
      </div>
      <div class="flow-card destination-card">
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="integration-logo google-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" fill="currentColor" opacity="0.3"/>
              <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h-6V6z" fill="currentColor"/>
            </svg>
          </div>
          <div class="integration-info">
            <span class="integration-name">Google Ads</span>
            <span class="integration-type">Advertising Platform</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
